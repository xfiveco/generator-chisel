{% set item_title = item.attr_title is not empty ? 'title="' ~ item.attr_title|e('html_attr') ~ '"' : '' %}
{% set opens_new_tab = item.target == '_blank' %}
{% set item_target = opens_new_tab ? 'target="_blank" rel="noopener noreferrer"' : '' %}
{% set item_current = item.current %}
{% set item_aria_current = item_current ? 'aria-current="page"' : '' %}
{% set has_submenu = item.children is not empty and main_nav_level < main_nav_level_max %}
{% set submenu_id = 'main-nav-submenu-' ~ item.id %}
{% set is_active = 'current-menu-parent' in item.classes %}
{% set has_default_submenu = item.meta('mega_menu_default_dropdown') %}

<li class="c-main-nav__{{ sub }}item {{ item.classes|join(' ') }} js-main-nav-item{{ is_active ? ' is-active' : '' }}{% if has_default_submenu == 'yes' %} is-default{% endif %}">
  <a href="{{ item.url }}" class="c-main-nav__{{ sub }}link js-main-nav-link" {{ item_target|raw }} {{ item_title|raw }} {{ item_aria_current|raw }}>{{ item_title|raw }}{% if opens_new_tab %}<span class="u-sr-only"> ({{ __('opens in a new tab', 'chisel') }})</span>{% endif %}</a>

  {% if has_submenu %}
    <button type="button" class="c-main-nav__caret js-main-nav-caret" aria-expanded="{{ is_active ? 'true' : 'false' }}" aria-controls="{{ submenu_id }}" aria-label="{{ __('Toggle submenu', 'chisel')|e('html_attr') }}"></button>

    {% set main_nav_level = main_nav_level + 1 %}

    <ul id="{{ submenu_id }}" class="c-main-nav__subitems is-level-{{ main_nav_level }}">
      {% for subitem in item.children %}
        {% include 'components/main-nav-item.twig' with {item: subitem, sub: 'sub'} %}
      {% endfor %}
    </ul>
  {% endif %}
</li>
