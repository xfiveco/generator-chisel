{
  "name": "<%= app.nameSlug %>",
  "version": "2.6.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "author": "<%= app.author %>",
  "description": "Chisel WP",
  "scripts": {
    "devcontainer": "npx @devcontainers/cli@0.71",
    "devcontainer:up": "npm run --silent devcontainer -- up --workspace-folder ../../..",
    "devcontainer:enter": "/usr/bin/env bash ../../../.devcontainer/exec bash",
    "devcontainer:start": "/usr/bin/env bash ../../../.devcontainer/exec npm run --silent start",
    "//icons-module": "Add --use-icons-module to start and build-scripts jobs to enable icons module. Also requires scss and functions.php configuration.",
    "start": "chisel-scripts start --experimental-modules",
    "dev": "npm run --silent start",
    "build-scripts": "chisel-scripts build --experimental-modules",
    "build": "npm run build-scripts && npm run lint && npm run phpcs && npm run twigcs && npm run check-update",
    "add-page": "chisel-scripts add-page",
    "create-block": "chisel-scripts create-block --category=chisel-blocks --namespace=chisel",
    "wp": "chisel-scripts wp",
    "composer": "chisel-scripts composer",
    "wp-config": "chisel-scripts wp-config",
    "phpcs": "cross-env vendor/bin/phpcs --extensions=php --exclude=Generic.PHP.Syntax",
    "phpcbf": "cross-env vendor/bin/phpcbf --extensions=php --exclude=Generic.PHP.Syntax",
    "twigcs": "cross-env vendor/bin/twigcs --config=twig_cs.php",
    "check-update": "chisel-scripts check-chisel-update && chisel-scripts check-ai-toolkit-update && chisel-scripts check-mcp-update",
    "check-update-ai-toolkit": "chisel-scripts check-ai-toolkit-update",
    "check-update-mcp": "chisel-scripts check-mcp-update",
    "update-chisel": "chisel-scripts chisel-update",
    "update-ai-toolkit": "chisel-scripts update-ai-toolkit",
    "update-mcp": "chisel-scripts update-mcp",
    "update": "npm run check-update && npm run update-chisel",
    "prepare": "chisel-scripts husky-init || node -e \"\"",
    "lint:script": "eslint . --fix && echo Linting scripts completed successfully",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\" --aei --fix --ignore-path .stylelintignore --ignore-path .gitignore && echo Linting styles completed successfully",
    "lint": "npm run --silent lint:script && npm run --silent lint:style",
    "format": "prettier --write --ignore-unknown --log-level warn \"**/*\" && echo Formatting completed successfully",
    "format-and-lint": "npm run --silent format && npm run --silent lint"
  },
  "dependencies": {
    "swiper": "^14.4.0",
    "@wordpress/interactivity": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wordpress/scripts": "^37.1.0",
    "chisel-scripts": "*",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-prettier": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "chisel": {
    "url": "http://<%= app.nameSlug %>.test/",
    "tablePrefix": "<%= wp.tablePrefix %>"
  }
}
